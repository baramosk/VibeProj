# 가계부 백엔드 환경 변수 예시
# 복사해서 .env 로 저장한 뒤 값을 조정합니다. 실제 비밀 값은 커밋하지 않습니다.
# 모든 키는 LEDGER_ 접두사를 씁니다.

# 데이터베이스 (SQLite 파일). 나중에 PostgreSQL로 바꿀 때 이 값만 바꿉니다.
LEDGER_DATABASE_URL=sqlite:///./ledger.db

# 세션 (NFR-03): 미사용 시 만료 기간(일)
LEDGER_SESSION_TTL_DAYS=14
LEDGER_SESSION_COOKIE_NAME=ledger_session
# NFR-02: 배포(HTTPS)에서는 true. 로컬 HTTP 개발 시에만 false
LEDGER_SESSION_COOKIE_SECURE=true

# 로그인 실패 잠금 (FR-02): window 분 안에 max_failures 회 실패하면 lock 분 동안 잠금
LEDGER_LOGIN_MAX_FAILURES=5
LEDGER_LOGIN_FAILURE_WINDOW_MINUTES=10
LEDGER_LOGIN_LOCK_MINUTES=15

# 예산 알림 임계치 (FR-21, Q-09): 쉼표 없이 JSON 배열로 씁니다
LEDGER_BUDGET_ALERT_THRESHOLDS=[80,100]

# 프런트엔드 개발 서버 출처 (CORS, JSON 배열)
LEDGER_CORS_ORIGINS=["http://localhost:5173"]

# HTTPS 배포 시 HSTS 헤더 사용 (NFR-08)
LEDGER_HSTS_ENABLED=false

# 개발 중에만 /docs(Swagger UI)를 켭니다. 운영에서는 false
LEDGER_DOCS_ENABLED=false
